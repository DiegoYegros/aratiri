# Aratiri production environment — mirrors the server's ~/aratiri-deploy/.env.
# Copy this file to <deploy-dir>/.env and fill in real values.
# docker-compose.prod.yml and deploy/deploy.sh read it.

# --- Postgres ---
POSTGRES_USER=aratiri_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aratiri_db

# --- Spring datasource (reaches db over the compose network) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/aratiri_db
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=aratiri_user
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_DDL_AUTO=validate
SERVER_PORT=2100

# --- Kafka (compose-internal) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- App URLs ---
# Public origin of the backend; used for webhook/LNURL callbacks etc.
ARATIRI_BASE_URL=http://your_public_host:2100
# Comma-separated list of allowed CORS origins (frontend + admin).
ARATIRI_CORS_ALLOWED_ORIGINS=http://your_public_host:3000,http://your_public_host:3001

# --- Payment defaults ---
ARATIRI_PAYMENT_DEFAULT_FEE_LIMIT_SAT=50
ARATIRI_PAYMENT_DEFAULT_TIMEOUT_SECONDS=200

# --- LND (custodial path; gRPC over the compose network) ---
GRPC_CLIENT_LND_NAME=lnd
GRPC_CLIENT_LND_PORT=10009
ADMIN_MACAROON_PATH=/run/secrets/admin.macaroon
LND_TLS_CERT_PATH=/run/secrets/tls.cert

# --- Auth ---
JWT_SECRET=change_me_very_long_random_string
JWT_EXPIRATION=8400
JWT_REFRESH_EXPIRATION=2592000
GOOGLE_OAUTH_CLIENT_ID=

# --- Mail ---
ARATIRI_MAIL_HOST=smtp.gmail.com
ARATIRI_MAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- Hikari pool ---
HIKARI_MAXIMUM_POOL_SIZE=10

# --- Frontend (informational; NEXT_PUBLIC_* is baked in at image build time) ---
# Must match the NEXT_PUBLIC_API_BASE_URL build arg used by CI.
NEXT_PUBLIC_API_BASE_URL=http://your_public_host:2100/v1

# --- GHCR pull (only needed while packages are private) ---
# The repos are public on GitHub, but GHCR packages default to PRIVATE until
# flipped in package settings. Anonymous pulls work once public; until then
# the server must authenticate with a fine-grained PAT (read:packages on
# DiegoYegros/aratiri, aratiri-frontend, aratiri-admin).
GHCR_USERNAME=
GHCR_TOKEN=
