# Copy to .env next to docker-compose.yml and set a strong password.
# Never commit the real .env.

# Grafana admin login (UI at http://100.124.162.6:3002)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_random

# Tailscale IP used for Prometheus (:9090) and Grafana (:3002) listen binds.
# Must match the host Tailscale address — do not use 0.0.0.0.
TAILSCALE_IP=100.124.162.6
