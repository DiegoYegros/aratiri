# Aratiri observability pack environment template.
#
# Copy this file to .env on the server (`cp .env.example .env`) and fill in
# real values. .env must STAY server-only — it contains the Grafana admin
# password and is never committed.

# Tailscale IP of the production host; confirm with `tailscale ip -4`.
# Prometheus, Grafana and Loki bind this address; Promtail ships logs to
# ${TAILSCALE_IP}:3100.
TAILSCALE_IP=100.124.162.6

# Grafana admin login (defaults in docker-compose.yml — set real ones here).
GRAFANA_ADMIN_USER=admin
# MUST be set; docker-compose fails at up when empty (${VAR:?}).
GRAFANA_ADMIN_PASSWORD=
